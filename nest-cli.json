{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/job-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/job-server/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/job-server",
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "utils": {
      "type": "library",
      "root": "libs/utils",
      "entryFile": "index",
      "sourceRoot": "libs/utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/utils/tsconfig.lib.json"
      }
    },
    "job-server": {
      "type": "application",
      "root": "apps/job-server",
      "entryFile": "main",
      "sourceRoot": "apps/job-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/job-server/tsconfig.app.json"
      }
    }
  }
}
